# ================================================================
# DREAM CYBER SECURITY PAKISTAN - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local to git.
# ================================================================

# MongoDB Connection String (e.g. MongoDB Atlas or local mongod)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dcs_pakistan?retryWrites=true&w=majority

# JWT Secret for Admin Authentication (32+ characters recommended)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://www.dreamcybersecurity.pk

# Gmail SMTP Configuration for Contact Form Notifications
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
